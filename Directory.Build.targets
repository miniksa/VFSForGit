<Project>

  <!-- Define common properties that rely on SDK/props-defined properties -->
  <PropertyGroup>
    <Version>$(GVFSVersion)</Version>

    <!--
      We parse this version into System.Version in several places;
      we should strip the commit ID from the attribute.
      -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Include custom MSBuild targets/tasks -->
  <Import Project="$(MSBuildThisFileDirectory)GVFS\GVFS.MSBuild\GVFS.targets" />

  <!--
    Copy ijwhost.dll for C++/CLI mixed-mode assembly support (ProjectedFSLib.Managed.dll).
    On .NET Core, mixed-mode assemblies require ijwhost.dll in the output directory.
  -->
  <Target Name="_CopyIjwHost" AfterTargets="Build" Condition="'$(MSBuildProjectExtension)' == '.csproj' AND '$(OutputType)' == 'Exe'">
    <ItemGroup>
      <_IjwHostFile Include="$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Host.win-x64\*\runtimes\win-x64\native\ijwhost.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_IjwHostFile->'%(FullPath)')" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_IjwHostFile)' != ''" />
  </Target>

</Project>
