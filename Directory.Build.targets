<Project>

  <!-- Define common properties that rely on SDK/props-defined properties -->
  <PropertyGroup>
    <Version>$(GVFSVersion)</Version>

    <!--
      We parse this version into System.Version in several places;
      we should strip the commit ID from the attribute.
      -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Include custom MSBuild targets/tasks -->
  <Import Project="$(MSBuildThisFileDirectory)GVFS\GVFS.MSBuild\GVFS.targets" />

  <!--
    Copy ijwhost.dll for C++/CLI mixed-mode assembly support (ProjectedFSLib.Managed.dll).
    On .NET Core, mixed-mode assemblies require ijwhost.dll in the output directory.
  -->
  <Target Name="_CopyIjwHost" AfterTargets="Build" Condition="'$(MSBuildProjectExtension)' == '.csproj' AND '$(OutputType)' == 'Exe'">
    <ItemGroup>
      <_IjwHostFile Include="$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Host.win-x64\*\runtimes\win-x64\native\ijwhost.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_IjwHostFile->'%(FullPath)')" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(_IjwHostFile)' != ''" />
  </Target>

  <Target Name="_CopyIjwHostPublish" AfterTargets="Publish" Condition="'$(MSBuildProjectExtension)' == '.csproj' AND '$(OutputType)' == 'Exe'">
    <ItemGroup>
      <_IjwHostFilePublish Include="$(NetCoreTargetingPackRoot)\Microsoft.NETCore.App.Host.win-x64\*\runtimes\win-x64\native\ijwhost.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_IjwHostFilePublish->'%(FullPath)')" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'@(_IjwHostFilePublish)' != ''" />
  </Target>

  <!--
    Copy native C++ hook executables to managed project output directories.
    These hooks are built separately with VS MSBuild (vcxproj) and need to be
    co-located with GVFS.exe for clone/mount operations.
  -->
  <Target Name="_CopyNativeHooks" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'GVFS' OR '$(MSBuildProjectName)' == 'GVFS.Mount' OR '$(MSBuildProjectName)' == 'FastFetch'">
    <ItemGroup>
      <_NativeHook Include="$(RepoOutPath)GitHooksLoader\bin\x64\$(Configuration)\GitHooksLoader.exe" />
      <_NativeHook Include="$(RepoOutPath)GVFS.ReadObjectHook\bin\x64\$(Configuration)\GVFS.ReadObjectHook.exe" />
      <_NativeHook Include="$(RepoOutPath)GVFS.PostIndexChangedHook\bin\x64\$(Configuration)\GVFS.PostIndexChangedHook.exe" />
      <_NativeHook Include="$(RepoOutPath)GVFS.VirtualFileSystemHook\bin\x64\$(Configuration)\GVFS.VirtualFileSystemHook.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeHook)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>

</Project>
