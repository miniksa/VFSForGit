<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputType>Exe</OutputType>
    <AssemblyName>GVFS.NativeHooks</AssemblyName>
    <RootNamespace>GVFS.NativeHooks</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    This project builds a single NativeAOT exe that dispatches based on argv[0].
    After publish, copy the exe as:
      GVFS.ReadObjectHook.exe
      GVFS.PostIndexChangedHook.exe
      GVFS.VirtualFileSystemHook.exe
      GitHooksLoader.exe
  -->

</Project>
